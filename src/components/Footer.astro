---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <p class="footer__ask">Hiring for an internship, or building something that has to be measured right? Write to me.</p>
  <div>
    <a class="footer__big" href={`mailto:${site.email}`} data-measure>Email me <span class="arr" aria-hidden="true">→</span></a>
    <p class="footer__mail mono">{site.email}</p>
  </div>
  <div class="grid footer__links">
    <div class="col-a">
      <ul>
        {site.socials.map((s) => <li><a class="ulink" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
        <li><a class="ulink" href={site.resume} download="Ameya-Mhatre-Resume.pdf">Résumé (PDF)</a></li>
      </ul>
    </div>
    <p class="col-c xs">© {year} {site.name}</p>
  </div>
</footer>
