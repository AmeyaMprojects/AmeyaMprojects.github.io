---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import Loader from '../components/Loader.astro';
import Frame from '../components/Frame.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  footer?: boolean;
}
const { title, description = site.description, image = '/og.png', jsonLd: pageLd, footer = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, software engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Manipal Institute of Technology, Bengaluru' },
  knowsAbout: ['Python', 'Multi-agent LLM systems', 'LangGraph', 'Quantitative modelling', 'NIST CSF', 'ISO 27001'],
  sameAs: site.socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#e8eae5" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {pageLd && <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />}
    <link rel="preload" href="/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      try { if (location.pathname !== '/' || matchMedia('(max-width: 767px)').matches || sessionStorage.getItem('calibrated')) document.documentElement.classList.add('no-loader'); sessionStorage.setItem('calibrated', '1'); } catch (e) {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel"><span class="curtain__kicker mono">Measuring</span><span class="curtain__label" data-curtain-label></span><span class="curtain__edge"></span></div>
    </div>
    <div id="caliper" transition:persist="caliper" aria-hidden="true">
      <span class="cal__jaw" data-jaw="l"></span>
      <span class="cal__jaw" data-jaw="r"></span>
      <span class="cal__bar"></span>
      <span class="cal__val">0.0 px</span>
    </div>
    <Loader />
    <Frame />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer />}
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
